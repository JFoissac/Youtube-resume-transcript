{
  "manifest_version": 3,
  "name": "YouTube Transcription",
  "version": "1.0.0",
  "description": "Extraire et résumer les transcriptions YouTube avec ChatGPT",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "tabs"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.claude.ai/*", "*://*.chatgpt.com/*", "*://*.deepseek.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.claude.ai/*", "*://*.chatgpt.com/*", "*://*.deepseek.com/*"],
      "js": ["claudeInjector.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
